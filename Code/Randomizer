<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Love and Information - Randomizer</title>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap" rel="stylesheet">
    <style>
        /* Core styles and variables */
        :root {
            --primary-red: #ef6596;
            --primary-blue: #4ecdc4;
            --background: #151515;
            --text-light: #ffffff;
            --text-dark: #2e2e2e;
            --container-bg: #ebc041;
            --grid-color: #ffffff33;
        }

        /* Base styles */
        body {
            font-family: 'VT323', monospace; 
            background-color: var(--background);
            color: var(--text-light);
            margin: 0;
            padding: 20px;
            background-image: 
                linear-gradient(var(--grid-color) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
            background-size: 30px 30px;
            line-height: 1.6;
            font-size: 18px;
        }

        /* Container and its decorative elements */
        .container {
            position: relative;
            max-width: 800px;
            margin: 40px auto;
            background-color: var(--container-bg);
            padding: 5px 30px 30px;
            z-index: 1;
            color: var(--text-dark);
        }

        .container::before,
        .container::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
        }

        .container::before {
            background-color: var(--primary-red);
            transform: translate(-20px, -10px);
        }

        .container::after {
            background-color: var(--primary-blue);
            transform: translate(-40px, -20px);
        }

        /* Typography */
        h1 {
            font-family: 'Press Start 2P', cursive;
            text-align: left;
            margin-bottom: 30px;
            font-size: 1.8em;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Status bar styles */
        .status-bar {
            border: 2px solid var(--primary-red);
            padding: 10px;
            margin: 20px 0;
            display: flex;
            justify-content: space-between;
            background-color: var(--text-dark);
            color: var(--text-light);
        }

        #lastUpdated, 
        .update-info {
            font-size: 1.1em;
        }

        /* Scene list styles */
        #sceneList {
            margin: 20px 0;
        }

        .scene {
            padding: 10px;
            margin-bottom: 5px;
            border-bottom: 2px solid var(--primary-red);
            display: flex;
            align-items: center;
        }

        .scene-number {
            margin-right: 20px;
            min-width: 30px;
            color: var(--text-light);
            font-weight: bold;
            font-size: 1.2em;
        }

        /* Act styles */
        .act-header {
            font-family: 'Press Start 2P', cursive;
            color: var(--text-light);
            padding: 20px 0 10px;
            font-size: 1.2em;
            text-transform: uppercase;
        }
        
        .act-container {
            border-left: 3px solid var(--primary-red);
            margin-left: 10px;
            padding-left: 20px;
            margin-bottom: 30px;
        }
        
        .depression-scene {
            color: var(--text-light);
        }

        /* Download button styles */
        .download-btn {
            display: inline-block;
            width: 350px;
            padding: 15px 20px;
            background-color: var(--primary-red);
            color: var(--text-light);
            border: none;
            cursor: pointer;
            font-family: 'Press Start 2P', cursive;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 0.8em;
            position: relative;
            transition: all 0.3s ease;
            text-align: center;
            white-space: nowrap;
        }

        .download-btn:hover {
            background-color: #120458;
        }

        .download-btn::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: var(--primary-blue);
            top: 4px;
            left: 4px;
            z-index: -1;
            transition: transform 0.2s ease;
        }

        .download-btn:hover::after {
            transform: translateY(2px);
        }
    </style>
</head>
<body>
    <!-- Main container -->
    <div class="container">
        <h1>Love and Information</h1> 
        <button class="download-btn" onclick="downloadSceneOrder()">Download Sequence</button>
        
        <!-- Status information -->
        <div class="status-bar">
            <div class="update-info">System Update: 4:00 PM EST Daily</div>
            <div id="lastUpdated"></div>
        </div>
        
        <!-- Scene list container -->
        <div id="sceneList"></div>
    </div>

    <script>
        // Configuration
        const CONFIG = {
            UPDATE_INTERVAL: 60000, // 1 minute in milliseconds
            ACTS_WITH_DEPRESSION: [1, 2, 5, 6, 7],
            SCENES_PER_ACT: {
                DEFAULT: 7,
                WITH_DEPRESSION: 9
            },
            TOTAL_ACTS: 7
        };
    
        // Fetches and displays the scene order from the server
        function updateSceneOrder() {
            fetch('scene_handler.php')
                .then(response => response.json())
                .then(handleSceneData)
                .catch(handleError);
        }
    
        // Handles the scene data received from the server
        function handleSceneData(data) {
            if (!isValidData(data)) return;
    
            const sceneHTML = generateSceneHTML(data.order);
            document.getElementById('sceneList').innerHTML = sceneHTML;
            updateTimestamp(data.last_update);
        }
    
        // Validates the received data
        function isValidData(data) {
            if (!data.order || !Array.isArray(data.order)) {
                console.error('Invalid order data received');
                return false;
            }
            return true;
        }
    
        // Generates HTML for all scenes
        function generateSceneHTML(currentOrder) {
            let sceneHTML = '';
            let currentIndex = 0;
            
            // Define exact number of scenes per act
            const scenesPerAct = {
                1: 9,  // Act 1: 9 scenes
                2: 8,  // Act 2: 8 scenes
                3: 8,  // Act 3: 8 scenes
                4: 9,  // Act 4: 9 scenes
                5: 8,  // Act 5: 8 scenes
                6: 8,  // Act 6: 8 scenes
                7: 10  // Act 7: 10 scenes (including Facts)
            };
        
            // Generate HTML for each act
            for (let actNumber = 1; actNumber <= 7; actNumber++) {
                const actScenes = currentOrder.slice(currentIndex, currentIndex + scenesPerAct[actNumber]);
                
                // Calculate starting scene number for this act
                const startNumber = actNumber === 1 ? 1 : 
                    Array.from({ length: actNumber - 1}, (_, i) => scenesPerAct[i + 1])
                        .reduce((sum, count) => sum + count, 1);
                
                sceneHTML += `
                    <div class="act-header">Act ${ actNumber}</div>
                    <div class="act-container">
                        ${actScenes.map((scene, index) => `
                            <div class="scene${ scene.includes('Depression') ? ' depression-scene' : ''}">
                                <span class="scene-number">${ (startNumber + index).toString().padStart(2, '0')}</span>
                                ${ scene}
                            </div>
                        `).join('')}
                    </div>
                `;
                
                currentIndex += scenesPerAct[actNumber];
            }
        
            return sceneHTML;
        }
    
        // Generates HTML for a single act
        function generateActHTML(actNumber, currentOrder, startIndex, startNumber) {
            const scenesInAct = getSceneCount(actNumber);
            const actScenes = currentOrder.slice(startIndex, startIndex + scenesInAct);
            
            return `
                <div class="act-header">Act ${ actNumber}</div>
                <div class="act-container">
                    ${ generateScenesHTML(actScenes, startNumber)}
                </div>
            `;
        }
    
        // Generates HTML for scenes within an act
        function generateScenesHTML(scenes, startNumber) {
            return scenes.map((scene, index) => `
                <div class="scene${ scene.includes('Depression') ? ' depression-scene' : ''}">
                    <span class="scene-number">${ (startNumber + index).toString().padStart(2, '0')}</span>
                    ${ scene}
                </div>
            `).join('');
        }
    
        // Generates HTML for the Facts scene
        function generateFactsHTML(number) {
            return `
                <div class="scene">
                    <span class="scene-number">${ number.toString().padStart(2, '0')}</span>
                    Facts
                </div>
            `;
        }
    
        // Gets the number of scenes for a specific act
        function getSceneCount(actNumber) {
            return CONFIG.ACTS_WITH_DEPRESSION.includes(actNumber) 
                ? CONFIG.SCENES_PER_ACT.WITH_DEPRESSION 
                : CONFIG.SCENES_PER_ACT.DEFAULT;
        }
    
        // Updates the last updated timestamp
        function updateTimestamp(timestamp) {
            if (!timestamp) return;
            
            const date = new Date(timestamp);
            date.setHours(date.getHours() - 5); // Adjust for EST
            const updateTime = date.toLocaleString('en-US', {  timeZone: 'America/New_York' });
            document.getElementById('lastUpdated').textContent = `Last Update: ${ updateTime}`;
        }
    
        // Handles errors in fetching scene data
        function handleError(error) {
            console.error('Error:', error);
            document.getElementById('sceneList').innerHTML = 'Error loading scenes. Please refresh the page.';
        }
    
        // Downloads the current scene order by reading from the HTML
        function downloadSceneOrder() {
            // Get timestamp from the displayed last update time
            const displayedTime = document.getElementById('lastUpdated').textContent
                .replace('Last Update: ', '');
            const timestamp = new Date(displayedTime);
    
            // Generate file content from displayed scenes
            const content = generateFileContentFromHTML();
            const fileName = `LoveAndInformation_SceneOrder_${ formatDate(timestamp)}.txt`;
            
            // Create and trigger download
            const blob = new Blob([content], {  type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
    
        // Generates file content by reading from the HTML
        function generateFileContentFromHTML() {
            const lastUpdate = document.getElementById('lastUpdated').textContent
                .replace('Last Update: ', '');
            
            let content = `LOVE AND INFORMATION - SCENE ORDER\n`;
            content += `Generated: ${ lastUpdate}\n`;
            content += `================================\n\n`;
    
            // Get all acts and scenes
            const acts = document.querySelectorAll('.act-header, .act-container');
            let currentAct = '';
    
            acts.forEach(element => {
                if (element.classList.contains('act-header')) {
                    // Start new act
                    currentAct = element.textContent;
                    content += `${ currentAct}\n`;
                    content += `${ '='.repeat(currentAct.length)}\n\n`;
                } else {
                    // Add scenes from this act
                    const scenes = element.querySelectorAll('.scene');
                    scenes.forEach(scene => {
                        const number = scene.querySelector('.scene-number').textContent;
                        const sceneName = scene.textContent.replace(number, '').trim();
                        content += `${ number}. ${sceneName}\n`;
                    });
                    content += '\n';
                }
            });
    
            return content;
        }
    
        // Formats date for filename
        function formatDate(date) {
            return `${ date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
        }
    
        // Initialize
        updateSceneOrder();
    </script>
</body>
</html>